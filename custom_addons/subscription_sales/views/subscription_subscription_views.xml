<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription List View -->
    <record id="view_subscription_subscription_tree" model="ir.ui.view">
        <field name="name">subscription.subscription.list</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions"
                  decoration-muted="stage == 'draft'"
                  decoration-info="stage == 'quotation'"
                  decoration-warning="stage in ('confirmed', 'paused')"
                  decoration-success="stage == 'active'"
                  decoration-danger="stage == 'closed'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="start_date"/>
                <field name="expiry_date"/>
                <field name="next_billing_date"/>
                <field name="amount_total" widget="monetary" sum="Total Recurring"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="stage" widget="badge"
                       decoration-muted="stage == 'draft'"
                       decoration-info="stage == 'quotation'"
                       decoration-warning="stage in ('confirmed', 'paused')"
                       decoration-success="stage == 'active'"
                       decoration-danger="stage == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="view_subscription_subscription_form" model="ir.ui.view">
        <field name="name">subscription.subscription.form</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_send_quotation"
                            string="Send Quotation"
                            type="object"
                            class="oe_highlight"
                            invisible="stage != 'draft'"/>
                    <button name="action_confirm"
                            string="Confirm Order"
                            type="object"
                            class="oe_highlight"
                            invisible="stage not in ('draft', 'quotation')"/>
                    <button name="action_activate"
                            string="Activate"
                            type="object"
                            class="oe_highlight btn-success"
                            invisible="stage not in ('confirmed', 'paused')"/>
                    <button name="action_pause"
                            string="Pause"
                            type="object"
                            invisible="stage != 'active'"/>
                    <button name="action_resume"
                            string="Resume"
                            type="object"
                            class="oe_highlight"
                            invisible="stage != 'paused'"/>
                    <button name="action_renew"
                            string="Renew"
                            type="object"
                            invisible="stage not in ('active', 'closed')"/>
                    <button name="action_close"
                            string="Close / Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="stage in ('draft', 'closed')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="stage != 'closed'"/>
                    <field name="stage" widget="statusbar" statusbar_visible="draft,quotation,confirmed,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="customer_info" string="Customer &amp; Agreement">
                            <field name="partner_id" widget="res_partner_many2one" context="{'show_address': 1}"/>
                            <field name="template_id" options="{'no_create': True}"/>
                            <field name="plan_id" options="{'no_create_edit': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="dates_terms" string="Dates &amp; Schedule">
                            <field name="start_date"/>
                            <field name="expiry_date"/>
                            <field name="next_billing_date"/>
                            <field name="payment_terms"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="close_reason" invisible="stage != 'closed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Subscription Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="tax_percent"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="price_total" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group col="12" class="oe_invoice_amount_total">
                                <group colspan="8"/>
                                <group colspan="4">
                                    <field name="amount_untaxed" widget="monetary"/>
                                    <field name="amount_tax" widget="monetary"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="amount_total"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                </group>
                            </group>
                        </page>
                        <page name="terms" string="Terms &amp; Notes">
                            <field name="terms_conditions" placeholder="Specific contractual terms..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Subscription Search View -->
    <record id="view_subscription_subscription_search" model="ir.ui.view">
        <field name="name">subscription.subscription.search</field>
        <field name="model">subscription.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name" string="Subscription" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="plan_id"/>
                <field name="user_id"/>
                <separator/>
                <filter name="filter_active" string="Active Subscriptions" domain="[('stage', '=', 'active')]"/>
                <filter name="filter_quotations" string="Quotes / Drafts" domain="[('stage', 'in', ('draft', 'quotation'))]"/>
                <filter name="filter_confirmed" string="Confirmed" domain="[('stage', '=', 'confirmed')]"/>
                <filter name="filter_paused" string="Paused" domain="[('stage', '=', 'paused')]"/>
                <filter name="filter_closed" string="Closed" domain="[('stage', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_stage" string="Status" context="{'group_by': 'stage'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_plan" string="Plan" context="{'group_by': 'plan_id'}"/>
                    <filter name="group_user" string="Salesperson" context="{'group_by': 'user_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Subscriptions Action -->
    <record id="action_subscription_subscription_all" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_active': 1}</field>
        <field name="search_view_id" ref="view_subscription_subscription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No subscriptions created yet!
            </p>
            <p>
                Manage contracts, track customer subscription lifecycles from quotation to active recurring billing.
            </p>
        </field>
    </record>

    <!-- Quotations Action -->
    <record id="action_subscription_quotations" model="ir.actions.act_window">
        <field name="name">Subscription Quotations</field>
        <field name="res_model">subscription.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_quotations': 1, 'default_stage': 'draft'}</field>
        <field name="search_view_id" ref="view_subscription_subscription_search"/>
    </record>
</odoo>
