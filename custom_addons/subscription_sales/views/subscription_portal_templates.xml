<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal Home Entry for Subscriptions -->
    <template id="portal_my_home_subscriptions" name="Portal My Home : Subscriptions" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Subscriptions</t>
                <t t-set="url" t-value="'/my/subscriptions'"/>
                <t t-set="placeholder_count" t-value="'subscription_count'"/>
            </t>
        </xpath>
    </template>
</odoo>
