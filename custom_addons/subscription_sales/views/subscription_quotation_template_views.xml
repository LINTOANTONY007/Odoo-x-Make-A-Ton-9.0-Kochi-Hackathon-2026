<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Quotation Template List View -->
    <record id="view_subscription_quotation_template_tree" model="ir.ui.view">
        <field name="name">subscription.quotation.template.list</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <list string="Quotation Templates">
                <field name="name"/>
                <field name="plan_id"/>
                <field name="validity_days"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Quotation Template Form View -->
    <record id="view_subscription_quotation_template_form" model="ir.ui.view">
        <field name="name">subscription.quotation.template.form</field>
        <field name="model">subscription.quotation.template</field>
        <field name="arch" type="xml">
            <form string="Quotation Template">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Standard 10-Seat SaaS Package"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="plan_id"/>
                            <field name="validity_days"/>
                        </group>
                        <group>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Default Products &amp; Add-ons">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Template Terms">
                            <field name="note" placeholder="Standard terms and conditions pre-filled on quotes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Quotation Template Action -->
    <record id="action_subscription_quotation_template" model="ir.actions.act_window">
        <field name="name">Quotation Templates</field>
        <field name="res_model">subscription.quotation.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first quotation template!
            </p>
            <p>
                Quotation templates allow sales reps to prepare offers for large customers quickly with pre-defined plans, products, and terms.
            </p>
        </field>
    </record>
</odoo>
