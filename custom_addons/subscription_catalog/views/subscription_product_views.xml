<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Product Template Form View -->
    <record id="view_product_template_subscription_form" model="ir.ui.view">
        <field name="name">product.template.subscription.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="is_subscription"/>
                    <label for="is_subscription"/>
                </span>
            </xpath>
            <xpath expr="//page[@name='general_information']" position="after">
                <page name="subscription_config" string="Subscription Plans" invisible="not is_subscription">
                    <group>
                        <group name="sub_plans" string="Allowed Plans">
                            <field name="brand" placeholder="e.g. Odoo Brand (+560)"/>
                            <field name="subscription_plan_ids" widget="many2many_tags" placeholder="Link available plans..."/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Subscription Products Action -->
    <record id="action_subscription_products" model="ir.actions.act_window">
        <field name="name">Subscription Products</field>
        <field name="res_model">product.template</field>
        <field name="domain">[('is_subscription', '=', True), ('type', '=', 'service')]</field>
        <field name="context">{'default_is_subscription': True, 'default_type': 'service'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your subscription products and services!
            </p>
            <p>
                Configure recurring software items, add-on modules, and variant options (such as brand variants).
            </p>
        </field>
    </record>

    <!-- Menu Item for Products -->
    <menuitem id="menu_subscription_product"
              name="Subscription Products"
              parent="menu_subscription_catalog"
              action="action_subscription_products"
              sequence="20"/>
</odoo>
