<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Subscription Plan List View -->
    <record id="view_subscription_plan_tree" model="ir.ui.view">
        <field name="name">subscription.plan.list</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="billing_frequency"/>
                <field name="cost" widget="monetary"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="min_quantity"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="is_available" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Subscription Plan Form View -->
    <record id="view_subscription_plan_form" model="ir.ui.view">
        <field name="name">subscription.plan.form</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Monthly Standard Plan"/>
                        </h1>
                    </div>
                    <group>
                        <group name="billing_info" string="Billing &amp; Pricing">
                            <field name="code"/>
                            <field name="billing_frequency"/>
                            <field name="billing_interval_count"/>
                            <label for="cost"/>
                            <div class="o_row">
                                <field name="cost" widget="monetary"/>
                                <field name="currency_id" options="{'no_open': True, 'no_create': True}"/>
                            </div>
                            <field name="min_quantity"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="availability_info" string="Availability &amp; Lifecycle">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="is_available" readonly="1"/>
                            <field name="active"/>
                            <separator string="Plan Policies" colspan="2"/>
                            <field name="auto_close_at_end"/>
                            <field name="allow_early_close"/>
                            <field name="allow_pause"/>
                            <field name="allow_renewal"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="products" string="Eligible Products">
                            <field name="product_ids" widget="many2many_tags" placeholder="Select products that can be bundled under this plan..."/>
                        </page>
                        <page name="terms" string="Description &amp; Terms">
                            <field name="description" placeholder="Specify terms, service level agreement, or customer-facing details..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Subscription Plan Search View -->
    <record id="view_subscription_plan_search" model="ir.ui.view">
        <field name="name">subscription.plan.search</field>
        <field name="model">subscription.plan</field>
        <field name="arch" type="xml">
            <search string="Search Plans">
                <field name="name" string="Plan" filter_domain="['|', ('name', 'ilike', self), ('code', 'ilike', self)]"/>
                <field name="billing_frequency"/>
                <separator/>
                <filter name="filter_available" string="Currently Available" domain="[('is_available', '=', True)]"/>
                <filter name="filter_monthly" string="Monthly Plans" domain="[('billing_frequency', '=', 'monthly')]"/>
                <filter name="filter_yearly" string="Yearly Plans" domain="[('billing_frequency', '=', 'yearly')]"/>
                <separator/>
                <filter name="filter_archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_frequency" string="Billing Frequency" context="{'group_by': 'billing_frequency'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Plan Window Action -->
    <record id="action_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_plan_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan!
            </p>
            <p>
                Configure billing frequency (daily, weekly, monthly, yearly), minimum quantities, availability windows, and renewal/cancellation policies.
            </p>
        </field>
    </record>

    <!-- Menu Item for Plans -->
    <menuitem id="menu_subscription_plan"
              name="Subscription Plans"
              parent="menu_subscription_catalog"
              action="action_subscription_plan"
              sequence="10"/>
</odoo>
