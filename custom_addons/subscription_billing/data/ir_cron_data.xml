<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Billing Day Cron Job -->
        <record id="cron_subscription_recurring_billing" model="ir.cron">
            <field name="name">Subscription: Automated Billing Day Run</field>
            <field name="model_id" ref="subscription_sales.model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_recurring_billing()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Auto-Close Expired Subscriptions Cron Job -->
        <record id="cron_subscription_auto_close" model="ir.cron">
            <field name="name">Subscription: Auto-Close Expired Contracts</field>
            <field name="model_id" ref="subscription_sales.model_subscription_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_auto_close_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
