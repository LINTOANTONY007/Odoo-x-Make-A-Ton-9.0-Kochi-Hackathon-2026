              name="Billing &amp; Invoices"
              parent="subscription_catalog.menu_subscription_root"
              sequence="30"/>

    <menuitem id="menu_subscription_invoices"
              name="Invoices"
              parent="menu_subscription_billing"
              action="action_subscription_invoice_all"
              sequence="10"/>

    <menuitem id="menu_subscription_payments"
              name="Payments"
              parent="menu_subscription_billing"
              action="action_subscription_payment_all"
              sequence="20"/>

    <!-- Reporting Submenu -->
    <menuitem id="menu_subscription_reporting"
              name="Finance &amp; Reports"
              parent="subscription_catalog.menu_subscription_root"
              sequence="40"/>

    <menuitem id="menu_subscription_finance_dashboard"
              name="Finance Lead Dashboard"
              parent="menu_subscription_reporting"
              action="action_subscription_finance_dashboard"
