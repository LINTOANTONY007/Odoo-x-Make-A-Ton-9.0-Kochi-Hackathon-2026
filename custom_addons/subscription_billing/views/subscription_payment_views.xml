<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Payment List View -->
    <record id="view_subscription_payment_tree" model="ir.ui.view">
        <field name="name">subscription.payment.list</field>
        <field name="model">subscription.payment</field>
        <field name="arch" type="xml">
            <list string="Subscription Payments">
                <field name="name"/>
                <field name="payment_date"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <field name="amount" widget="monetary" sum="Total Collected"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <!-- Payment Form View -->
    <record id="view_subscription_payment_form" model="ir.ui.view">
        <field name="name">subscription.payment.form</field>
        <field name="model">subscription.payment</field>
        <field name="arch" type="xml">
            <form string="Customer Payment">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="invoice_id" domain="[('state', '=', 'confirmed')]"/>
                            <field name="partner_id"/>
                            <field name="payment_method"/>
                        </group>
                        <group>
                            <field name="amount" widget="monetary"/>
                            <field name="payment_date"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="note" placeholder="Wire transfer reference, receipt ID, or check note..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Payment Search View -->
    <record id="view_subscription_payment_search" model="ir.ui.view">
        <field name="name">subscription.payment.search</field>
        <field name="model">subscription.payment</field>
        <field name="arch" type="xml">
            <search string="Search Payments">
                <field name="name" string="Payment / Reference"/>
                <field name="invoice_id"/>
                <field name="partner_id"/>
                <field name="payment_method"/>
                <group expand="0" string="Group By">
                    <filter name="group_method" string="Payment Method" context="{'group_by': 'payment_method'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'payment_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Payment Action -->
    <record id="action_subscription_payment_all" model="ir.actions.act_window">
        <field name="name">Payments Collected</field>
        <field name="res_model">subscription.payment</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subscription_payment_search"/>
    </record>
</odoo>
