<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Invoice List View -->
    <record id="view_subscription_invoice_tree" model="ir.ui.view">
        <field name="name">subscription.invoice.list</field>
        <field name="model">subscription.invoice</field>
        <field name="arch" type="xml">
            <list string="Invoices"
                  decoration-muted="state == 'draft'"
                  decoration-info="state == 'confirmed' and not is_overdue"
                  decoration-danger="is_overdue"
                  decoration-success="state == 'paid'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <field name="invoice_date"/>
                <field name="due_date"/>
                <field name="amount_total" widget="monetary" sum="Total Invoiced"/>
                <field name="amount_paid" widget="monetary" sum="Total Paid"/>
                <field name="amount_due" widget="monetary" sum="Total Outstanding"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="is_overdue" widget="boolean_toggle"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft'"
                       decoration-info="state == 'confirmed'"
                       decoration-success="state == 'paid'"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Invoice Form View -->
    <record id="view_subscription_invoice_form" model="ir.ui.view">
        <field name="name">subscription.invoice.form</field>
        <field name="model">subscription.invoice</field>
        <field name="arch" type="xml">
            <form string="Subscription Invoice">
                <header>
                    <button name="action_confirm"
                            string="Confirm Invoice"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_send"
                            string="Send"
                            type="object"
                            class="oe_highlight"
                            invisible="state not in ('confirmed', 'paid')"/>
                    <button name="action_print"
                            string="Print"
                            type="object"
                            invisible="state not in ('confirmed', 'paid')"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state in ('paid', 'cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,paid"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group name="header_left">
                            <field name="partner_id" widget="res_partner_many2one" context="{'show_address': 1}"/>
                            <field name="subscription_id" options="{'no_create': True}"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group name="header_right">
                            <field name="invoice_date"/>
                            <field name="due_date"/>
                            <field name="payment_terms"/>
                            <field name="applied_discount_id" invisible="not applied_discount_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="lines" string="Invoice Lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="discount"/>
                                    <field name="discount_amount" widget="monetary"/>
                                    <field name="tax_ids" widget="many2many_tags"/>
                                    <field name="price_subtotal" widget="monetary"/>
                                    <field name="price_total" widget="monetary"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group col="12" class="oe_invoice_amount_total">
                                <group colspan="8"/>
                                <group colspan="4">
                                    <field name="amount_untaxed" widget="monetary"/>
                                    <field name="amount_discount" widget="monetary" invisible="amount_discount == 0"/>
                                    <field name="amount_tax" widget="monetary"/>
                                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                                        <label for="amount_total"/>
                                    </div>
                                    <field name="amount_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary"/>
                                    <field name="amount_paid" widget="monetary"/>
                                    <field name="amount_due" widget="monetary" class="oe_subtotal_footer_separator"/>
                                </group>
                            </group>
                        </page>
                        <page name="payments" string="Recorded Payments">
                            <field name="payment_ids">
                                <list editable="bottom">
                                    <field name="name" readonly="1"/>
                                    <field name="payment_method"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="payment_date"/>
                                    <field name="note"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Invoice Search View -->
    <record id="view_subscription_invoice_search" model="ir.ui.view">
        <field name="name">subscription.invoice.search</field>
        <field name="model">subscription.invoice</field>
        <field name="arch" type="xml">
            <search string="Search Invoices">
                <field name="name" string="Invoice" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <field name="subscription_id"/>
                <separator/>
                <filter name="filter_confirmed" string="Confirmed (Unpaid)" domain="[('state', '=', 'confirmed')]"/>
                <filter name="filter_overdue" string="Overdue Invoices" domain="[('is_overdue', '=', True)]"/>
                <filter name="filter_paid" string="Fully Paid" domain="[('state', '=', 'paid')]"/>
                <filter name="filter_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_date" string="Invoice Month" context="{'group_by': 'invoice_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Invoice Action -->
    <record id="action_subscription_invoice_all" model="ir.actions.act_window">
        <field name="name">Customer Invoices</field>
        <field name="res_model">subscription.invoice</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_confirmed': 1}</field>
        <field name="search_view_id" ref="view_subscription_invoice_search"/>
    </record>
</odoo>
