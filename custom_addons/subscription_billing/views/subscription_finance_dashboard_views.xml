<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Finance Dashboard Form View -->
    <record id="view_subscription_finance_report_form" model="ir.ui.view">
        <field name="name">subscription.finance.report.form</field>
        <field name="model">subscription.finance.report</field>
        <field name="arch" type="xml">
            <form string="Finance Lead Executive Dashboard" create="false" edit="false">
                <sheet>
                    <div class="oe_title">
                        <h2>Brightloop Software - Executive Recurring Revenue Dashboard</h2>
                    </div>
                    <group>
                        <group string="Subscription Portfolio">
                            <field name="active_subscriptions_count" readonly="1"/>
                            <field name="total_recurring_revenue" widget="monetary" readonly="1"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                        <group string="Collections &amp; Invoicing Status">
                            <field name="total_invoiced_amount" widget="monetary" readonly="1"/>
                            <field name="total_revenue_collected" widget="monetary" readonly="1"/>
                            <field name="total_outstanding_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                    <group string="Overdue Risk Exposure">
                        <group>
                            <field name="overdue_invoices_count" readonly="1"/>
                            <field name="total_overdue_amount" widget="monetary" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Finance Dashboard Action -->
    <record id="action_subscription_finance_dashboard" model="ir.actions.act_window">
        <field name="name">Finance Overview &amp; Reporting</field>
        <field name="res_model">subscription.finance.report</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
    </record>
</odoo>
