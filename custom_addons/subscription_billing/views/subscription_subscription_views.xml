<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Subscription Form to add Billing smart button and actions -->
    <record id="view_subscription_subscription_form_billing_inherit" model="ir.ui.view">
        <field name="name">subscription.subscription.form.billing.inherit</field>
        <field name="model">subscription.subscription</field>
        <field name="inherit_id" ref="subscription_sales.view_subscription_subscription_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_invoice"
                        string="Generate Due Invoice"
                        type="object"
                        class="oe_highlight"
                        invisible="stage != 'active'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-pencil-square-o">
                    <field name="invoice_count" widget="statinfo" string="Invoices"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='next_billing_date']" position="after">
                <field name="last_billing_date"/>
            </xpath>
        </field>
    </record>
</odoo>
