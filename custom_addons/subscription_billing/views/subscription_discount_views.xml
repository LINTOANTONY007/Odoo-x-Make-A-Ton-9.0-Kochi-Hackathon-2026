<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Discount Rules List View -->
    <record id="view_subscription_discount_tree" model="ir.ui.view">
        <field name="name">subscription.discount.list</field>
        <field name="model">subscription.discount</field>
        <field name="arch" type="xml">
            <list string="Discount Rules" decoration-muted="not is_valid">
                <field name="name"/>
                <field name="discount_type"/>
                <field name="discount_value"/>
                <field name="apply_to"/>
                <field name="min_purchase_amount"/>
                <field name="min_quantity"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="current_usage_count"/>
                <field name="max_usage_count"/>
                <field name="is_valid" widget="boolean_toggle"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Discount Rules Form View -->
    <record id="view_subscription_discount_form" model="ir.ui.view">
        <field name="name">subscription.discount.form</field>
        <field name="model">subscription.discount</field>
        <field name="arch" type="xml">
            <form string="Discount Rule">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. Volume Discount (10+ Seats)"/>
                        </h1>
                    </div>
                    <group>
                        <group name="rule_type" string="Discount Calculation">
                            <field name="discount_type"/>
                            <field name="discount_value"/>
                            <field name="apply_to"/>
                            <field name="product_ids" widget="many2many_tags" invisible="apply_to != 'specific_products'"/>
                        </group>
                        <group name="qualification" string="Qualification Thresholds">
                            <field name="min_quantity"/>
                            <field name="min_purchase_amount"/>
                        </group>
                    </group>
                    <group>
                        <group name="limits" string="Validity &amp; Usage Limit">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="max_usage_count"/>
                            <field name="current_usage_count"/>
                            <field name="is_valid"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Discount Window Action -->
    <record id="action_subscription_discount" model="ir.actions.act_window">
        <field name="name">Discount Rules</field>
        <field name="res_model">subscription.discount</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first automated discount rule!
            </p>
            <p>
                Admin-controlled rules for volume discounts, seat thresholds, and promotional expiry.
            </p>
        </field>
    </record>
</odoo>
